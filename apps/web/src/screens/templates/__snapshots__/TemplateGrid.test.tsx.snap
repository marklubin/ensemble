// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`TemplateGrid snapshots loading state renders two skeletons 1`] = `"<div class="tp-grid" data-state="loading" data-testid="template-grid"><div class="tp-skeleton" data-testid="template-skeleton"><div class="bar long"></div><div class="bar med"></div><div class="bar short"></div><div class="bar long"></div><div class="bar med"></div><span>Loading templates…</span></div><div class="tp-skeleton" data-testid="template-skeleton"><div class="bar long"></div><div class="bar med"></div><div class="bar short"></div><div class="bar long"></div><div class="bar med"></div><span>Loading templates…</span></div></div>"`;

exports[`TemplateGrid snapshots empty state shows a friendly hint 1`] = `"<div class="tp-grid" data-state="empty" data-testid="template-grid"><div class="tp-empty">No templates available yet. Build one with “Custom” below.</div></div>"`;

exports[`TemplateGrid snapshots populated state lists every template card with use button 1`] = `"<div class="tp-grid" data-state="ready" data-testid="template-grid"><article class="tp-card is-selected" data-template-id="debate" data-testid="template-card-debate"><div class="tp-corner is-debate">Debate</div><div class="tp-illustration"><div class="ill-line"><div class="role-col role p1">PRO</div><div class="dialog-col">Capital follows working systems…</div></div><div class="ill-line"><div class="role-col role p2">CON</div><div class="dialog-col">That&#x27;s the bubble-era sentence.</div></div><div class="mod-line">fact-check · <strong>Moderator:</strong> Pro&#x27;s claim checks out; Con&#x27;s is partially supported…</div><div class="ill-line"><div class="role-col role p1">PRO</div><div class="dialog-col">Right, but the Menlo median is the wrong number to anchor on…</div></div></div><h3 class="tp-name">Debate</h3><p class="tp-tagline">Two sides, a moderator.</p><ul class="tp-attrs"><li><span class="label">Cast</span><span class="value">2+ personas assigned to <strong>Pro or Con</strong></span></li><li><span class="label">Turn order</span><span class="value">Alternating, with shuffle each round</span></li><li><span class="label">Moderator</span><span class="value">Required — judge (via web_search)</span></li><li><span class="label">Concludes</span><span class="value">With a <strong>verdict</strong> synthesizing strongest arguments</span></li></ul><div class="tp-actions"><button type="button" class="tp-btn primary" data-testid="use-debate">Use Debate →</button><button type="button" class="tp-btn ghost">See example</button><span class="tp-meta">12 past debates</span></div></article><article class="tp-card" data-template-id="roundtable" data-testid="template-card-roundtable"><div class="tp-corner is-roundtable">Roundtable</div><div class="tp-illustration"><div class="ill-line"><div class="role-col role p2">KEITH</div><div class="dialog-col">Concur — that&#x27;s a really good point. The proper Kinelo answer…</div></div><div class="ill-line"><div class="role-col role p1">MARK</div><div class="dialog-col">Right, but routing and lookup need different layers…</div></div><div class="ill-line"><div class="role-col role p2">PETER</div><div class="dialog-col">I&#x27;m with Mark on the layering, but I&#x27;d add…</div></div><div class="ill-line"><div class="role-col role p1">IAN</div><div class="dialog-col">Can we step back? What&#x27;s the actual constraint?</div></div></div><h3 class="tp-name">Roundtable</h3><p class="tp-tagline">Equal voices.</p><ul class="tp-attrs"><li><span class="label">Cast</span><span class="value">2–6 personas, no assigned roles</span></li><li><span class="label">Turn order</span><span class="value">Reshuffled every round</span></li><li><span class="label">Moderator</span><span class="value">Optional — off by default</span></li><li><span class="label">Concludes</span><span class="value">Open-ended; ends with a summary</span></li></ul><div class="tp-actions"><button type="button" class="tp-btn primary" data-testid="use-roundtable">Use Roundtable →</button><button type="button" class="tp-btn ghost">See example</button><span class="tp-meta">3 past roundtables</span></div></article></div>"`;
