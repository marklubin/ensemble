# Ensemble server config
# Copy to .env and fill in.

# HTTP port for the Hono server
PORT=4111

# Anthropic API key (required for ManagedAgentsRuntime)
ANTHROPIC_API_KEY=

# Public URL the MCP server is reachable at (for tokens given to runtimes)
MCP_PUBLIC_URL=http://localhost:4111/mcp

# JWT signing secret for MCP token issuance (Phase 1B)
JWT_SECRET=change-me-in-production

# Memory backend: in-memory | sqlite (default sqlite for v1; in-memory for tests)
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_PATH=./ensemble.sqlite

# Test mode: fixture | live | record (set by tests)
ENSEMBLE_TEST_MODE=fixture

# Claude Code runtime
# Set CLAUDE_CODE_RUNTIME_ENABLED=true to register the runtime.
# CLAUDE_CODE_TRANSPORT picks the transport:
#   channel (default) — externally-launched Claude Code attaches over
#                       the channel-bridge WebSocket. See
#                       apps/channel-bridge/README.md.
#   cli               — legacy: spawn `claude -p` per turn.
#   mock              — in-process MockMcpTransport for tests / offline.
CLAUDE_CODE_RUNTIME_ENABLED=false
CLAUDE_CODE_TRANSPORT=channel

# Channel-bridge auth (shared between server and bridge). If unset, the
# server accepts any non-empty token at registration time.
# ENSEMBLE_CHANNEL_TOKEN=

# How long ChannelRuntime.attach waits for the bridge to connect
# before resolving (ms). Subsequent dispatches will still surface a
# typed error if the channel never registered.
# CLAUDE_CODE_CHANNEL_CONNECT_WAIT_MS=30000

# Legacy CLI transport tuning (only used when CLAUDE_CODE_TRANSPORT=cli):
# CLAUDE_BINARY=claude
# CLAUDE_CODE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_CODE_TIMEOUT_SEC=60
# CLAUDE_CODE_MAX_BUDGET_USD=0.10
