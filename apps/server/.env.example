# Ensemble server config
# Copy to .env and fill in.

# HTTP port for the Hono server
PORT=4111

# Anthropic API key (required for ManagedAgentsRuntime)
ANTHROPIC_API_KEY=

# Public URL the MCP server is reachable at (for tokens given to runtimes)
MCP_PUBLIC_URL=http://localhost:4111/mcp

# JWT signing secret for MCP token issuance (Phase 1B)
JWT_SECRET=change-me-in-production

# Memory backend: in-memory | sqlite (default sqlite for v1; in-memory for tests)
MEMORY_BACKEND=sqlite
MEMORY_SQLITE_PATH=./ensemble.sqlite

# Test mode: fixture | live | record (set by tests)
ENSEMBLE_TEST_MODE=fixture

# Claude Code runtime — v1.5
# Set CLAUDE_CODE_RUNTIME_ENABLED=true to register the runtime.
# Default: LocalCliTransport (spawns `claude -p` per turn). Set
# CLAUDE_CODE_TRANSPORT=mock to use the in-process MockMcpTransport.
CLAUDE_CODE_RUNTIME_ENABLED=false
# CLAUDE_BINARY=claude
# CLAUDE_CODE_MODEL=claude-haiku-4-5-20251001
# CLAUDE_CODE_TIMEOUT_SEC=60
# CLAUDE_CODE_MAX_BUDGET_USD=0.10
