{
  "name": "ensemble",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun --filter @ensemble/server dev",
    "dev:web": "bun --filter @ensemble/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/bun": "latest"
  }
}
