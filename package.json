{
  "name": "ensemble",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun --filter @ensemble/server dev",
    "dev:web": "bun --filter @ensemble/web dev",
    "build": "bun run --filter '*' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test && bun --filter @ensemble/web test",
    "test:server": "bun test",
    "test:web": "bun --filter @ensemble/web test",
    "test:e2e": "bun x playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/bun": "latest",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3"
  }
}
